FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Only install what the API needs — no comdirect connector, no secrets
RUN pip install --no-cache-dir "fastapi>=0.115.0" "uvicorn[standard]>=0.34.0" "httpx>=0.27.2" \
        "pydantic-settings>=2.0" "sqlalchemy>=2.0" "asyncpg>=0.30" && \
    adduser --disabled-password --gecos "" appuser && \
    mkdir -p /data/exports && chown appuser:appuser /data/exports

# Copy API module and its dependencies (core config, db models)
COPY src/__init__.py src/__init__.py
COPY src/api/ src/api/
COPY src/core/ src/core/

USER appuser

EXPOSE 8000

CMD ["uvicorn", "src.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
