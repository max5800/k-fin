# ---------------------------------------------------------------------------
# k-fin — Docker Compose environment
#
#   cp .env.compose.example .env
#   $EDITOR .env       # fill in COMDIRECT_*, rotate the change_me_* values
#   docker compose pull && docker compose up -d
#
# Variables in this file are read by docker-compose for ${VAR} substitution
# and forwarded to the right services via per-service `environment:` blocks.
# ---------------------------------------------------------------------------

# --- Image versions (pin to a release; bump as new tags ship to GHCR) ---
K_FIN_VERSION=1.28.2
K_FIN_UI_VERSION=v1.0.2

# --- Host port mappings (change if 8000 / 3000 are already in use) ---
API_PORT=8000
UI_PORT=3000

# --- Postgres ---
# Local-only credential. Change before exposing this stack to anything beyond
# your own machine. The compose file derives DATABASE_URL from this.
POSTGRES_PASSWORD=finance

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
EXPORTS_DIR=/data/exports
# CORS origin the UI talks from. If you change UI_PORT, update this too.
CORS_ORIGINS=http://localhost:3000

# --- Auth (CHANGE BEFORE FIRST RUN) ---
# Used by the api/worker when a request carries `Authorization: Bearer <token>`.
API_TOKEN=change_me_to_a_strong_random_token
# HS256 signing key for the JWT cookies the UI receives after login.
JWT_SECRET=change_me_to_a_strong_random_jwt_secret

# Bootstrap login — when enabled, POST /api/v1/auth/login accepts the fixed
# email/password pair below and returns API_TOKEN. Convenient for a single-
# user local stack; hard-disabled when APP_ENV=production.
BOOTSTRAP_LOGIN_ENABLED=true
BOOTSTRAP_EMAIL=dev@k-fin.local
BOOTSTRAP_PASSWORD=change_me_dev_only

# Initial users-table seed (consumed once by the migration job).
BOOTSTRAP_USER_EMAIL=dev@k-fin.local
BOOTSTRAP_USER_DISPLAY_NAME=Me
BOOTSTRAP_USER_INITIAL_PASSWORD=change_me_dev_only

# --- Comdirect bank credentials (worker only) ---
# Register at https://developer.comdirect.de/ to obtain client id/secret.
# Username is your account number, PIN is your online-banking PIN.
COMDIRECT_CLIENT_ID=
COMDIRECT_CLIENT_SECRET=
COMDIRECT_USERNAME=
COMDIRECT_PIN=
COMDIRECT_TAN_METHOD=pushTAN

# --- Banking ---
# Comma-separated list of your own IBANs — used to scope internal-transfer
# detection in the normalization pipeline.
OWN_IBANS=DE00000000000000000000

# --- Sync tunables (worker only) ---
SYNC_INTERVAL_MINUTES=60
SYNC_INITIAL_DAYS=90
SYNC_DEDUP_ENABLED=true
ACCOUNT_TRANSACTION_LIMIT=500
DEPOT_TRANSACTION_LIMIT=500
# Two-year window so the trailing-12M dividend KPI has enough history.
DEPOT_TRANSACTION_MIN_BOOKING_DATE=-730d

# --- Optional: LLM categorization ---
# Leave empty to disable the agent pipeline. Set to a sk-ant-... key to enable.
ANTHROPIC_API_KEY=
# Optional SearXNG instance for the agent's `search_web` tool. Empty disables.
SEARXNG_URL=
