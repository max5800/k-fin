# ── Comdirect ──────────────────────────────────────────────────────────────────
COMDIRECT_CLIENT_ID=your_client_id_here
COMDIRECT_CLIENT_SECRET=your_client_secret_here
COMDIRECT_USERNAME=your_depot_number_here
COMDIRECT_PIN=your_pin_here
# TAN method: photoTAN, pushTAN, smsTAN
COMDIRECT_TAN_METHOD=pushTAN

# ── Firefly III ────────────────────────────────────────────────────────────────
FIREFLY_BASE_URL=http://localhost:8080
FIREFLY_ACCESS_TOKEN=your_firefly_personal_access_token_here

# ── Sync Settings ──────────────────────────────────────────────────────────────
# How often to pull (minutes)
SYNC_INTERVAL_MINUTES=60
# How many days back to fetch on first run
SYNC_INITIAL_DAYS=90
# Enable deduplication
SYNC_DEDUP_ENABLED=true

# ── App ────────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
