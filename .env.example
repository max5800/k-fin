# Comdirect API credentials
# Register at: https://developer.comdirect.de/
COMDIRECT_CLIENT_ID=your_client_id_here
COMDIRECT_CLIENT_SECRET=your_client_secret_here
COMDIRECT_USERNAME=your_account_number_here
COMDIRECT_PIN=your_pin_here

# Santander Consumer Bank credit-card credentials (M16-P2c)
# MySantander online-banking login (1plus Visa Card). Worker-only — like the
# Comdirect credentials these must never reach the api service.
# SANTANDER_DEVICE_ID is optional: a remembered-device id that can skip 2FA.
SANTANDER_USERNAME=your_username_here
SANTANDER_PASSWORD=your_password_here
SANTANDER_DEVICE_ID=

# Export settings
EXPORTS_DIR=/data/exports

# REST API token (leave empty to disable auth)
API_TOKEN=change_me_to_a_strong_random_token

# Bootstrap login — DEV ONLY. When enabled, POST /api/v1/auth/login accepts
# the fixed BOOTSTRAP_EMAIL/BOOTSTRAP_PASSWORD pair and returns API_TOKEN
# so the UI can drive the full app end-to-end without real user management.
# Hard-disabled when APP_ENV=production.
BOOTSTRAP_LOGIN_ENABLED=false
BOOTSTRAP_EMAIL=dev@k-fin.local
BOOTSTRAP_PASSWORD=change_me_dev_only

# Comma-separated origins allowed by CORS middleware. Leave empty to omit
# the middleware entirely (relies on a same-origin proxy, e.g. the Vite
# dev server or the in-cluster Ingress).
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Local DB
DATABASE_URL=postgresql+psycopg://postgres:postgres_password@localhost:5432/finance

# Agent / LLM (M7)
ANTHROPIC_API_KEY=sk-ant-your-key-here
