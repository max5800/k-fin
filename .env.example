# Comdirect API credentials
# Register at: https://developer.comdirect.de/
COMDIRECT_CLIENT_ID=your_client_id_here
COMDIRECT_CLIENT_SECRET=your_client_secret_here
COMDIRECT_ZUGANGSNUMMER=your_account_number_here
COMDIRECT_PIN=your_pin_here

# Export settings
EXPORTS_DIR=/data/exports

# REST API token (leave empty to disable auth)
API_TOKEN=change_me_to_a_strong_random_token

# Firefly III (planned)
# FIREFLY_URL=http://your-firefly-instance:8080
# FIREFLY_TOKEN=your_firefly_personal_access_token
